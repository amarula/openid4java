<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.amarulasolutions</groupId>
  <artifactId>openid4java-shaded</artifactId>
  <version>2.0.0</version>
  <packaging>jar</packaging>

  <name>OpenID4Java Shaded</name>
  <description>
    Shaded OpenID4Java 2.0.0 for environments that need a single
    self-contained JAR with its third-party dependencies relocated.
  </description>
  <url>https://github.com/amarula/openid4java</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <openid4java.version>2.0.0</openid4java.version>
  </properties>

  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/amarula/openid4java</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.amarulasolutions</groupId>
      <artifactId>openid4java</artifactId>
      <version>${openid4java.version}</version>
    </dependency>
    <!-- Kept outside the shaded JAR so the host can provide them. -->
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.3.4</version>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.17.1</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>true</createDependencyReducedPom>
              <artifactSet>
                <excludes>
                  <exclude>commons-logging:commons-logging</exclude>
                  <exclude>commons-codec:commons-codec</exclude>
                  <exclude>org.slf4j:slf4j-api</exclude>
                  <exclude>org.ehcache:ehcache</exclude>
                  <exclude>org.springframework:*</exclude>
                </excludes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.google</pattern>
                  <shadedPattern>org.openid4java.shaded.google</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.hc</pattern>
                  <shadedPattern>org.openid4java.shaded.apache.hc</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.jsoup</pattern>
                  <shadedPattern>org.openid4java.shaded.jsoup</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>jakarta.inject</pattern>
                  <shadedPattern>org.openid4java.shaded.jakarta.inject</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.aopalliance</pattern>
                  <shadedPattern>org.openid4java.shaded.aopalliance</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/amarula/openid4java</url>
    </repository>
  </distributionManagement>
</project>
